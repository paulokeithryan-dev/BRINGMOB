      Rayfield:Notify({
         Title = "Script Unloaded",
         Content = "Disabled connections & restored mob states.",
         Duration = 3,
      })
      task.wait(0.3)
      Rayfield:Destroy()
   end,
})

Rayfield:Notify({
   Title = "Engine Updated",
   Content = "Ground-snapping bypass active!",
   Duration = 4,
})
