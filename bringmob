-- =====================================================================
-- DIRECT MOB TELEPORT ENGINE (VOID TP & BRING TO ME)
-- Bypasses walls/floors by forcing mob CFrames directly to Void or Player
-- =====================================================================

local Services = {
    Players = game:GetService("Players"),
    RunService = game:GetService("RunService"),
    Workspace = game:GetService("Workspace")
}

local LocalPlayer = Services.Players.LocalPlayer

-- Configuration
getgenv().DirectTPConfig = getgenv().DirectTPConfig or {
    Mode = "None",                   -- "Void", "Bring", or "None"
    VoidYLevel = -300,               -- Y-Coordinate for void death
    BringOffset = 4,                 -- Distance in front of player
    ScanRadius = 350,                -- Search radius in studs
    PulseInterval = 0.1,             -- TP refresh speed in seconds
    IgnorePlayers = true,            -- Ignore real player characters
    CustomFolderName = ""            -- Custom Workspace folder override
}

local TPLoopConnection = nil
local lastTP = 0

-- Multi-Mirror Safe Rayfield Loader
local Rayfield = nil
local rayfieldURLs = {
    "https://raw.githubusercontent.com/shlexware/Rayfield/main/source",
    "https://sirius.menu/rayfield",
    "https://raw.githubusercontent.com/SiriusSoftwareLTD/Rayfield/main/source"
}

for _, url in ipairs(rayfieldURLs) do
    local success, result = pcall(function()
        return loadstring(game:HttpGet(url))()
    end)
    if success and result then
        Rayfield = result
        break
    end
end

if not Rayfield then return end

-- Validate NPC / Mob
local function isValidMob(model)
    if not model or not model:IsA("Model") then return false end

    if getgenv().DirectTPConfig.IgnorePlayers and Services.Players:GetPlayerFromCharacter(model) then
        return false
    end

    local humanoid = model:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return false end

    local rootPart = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso")
    if not rootPart then return false end

    return true, rootPart, humanoid
end

-- Teleport Logic Execution
local function processTeleports()
    local mode = getgenv().DirectTPConfig.Mode
    if mode == "None" then return end

    if tick() - lastTP < getgenv().DirectTPConfig.PulseInterval then return end
    lastTP = tick()

    local character = LocalPlayer.Character
    local playerRoot = character and character:FindFirstChild("HumanoidRootPart")
    if not playerRoot then return end

    local playerPos = playerRoot.Position
    local searchContainer = Services.Workspace

    if getgenv().DirectTPConfig.CustomFolderName ~= "" then
        local folder = Services.Workspace:FindFirstChild(getgenv().DirectTPConfig.CustomFolderName)
        if folder then searchContainer = folder end
    end

    -- Target calculation based on active mode
    local function executeTP(mobModel, mobRoot)
        pcall(function()
            local dist = (mobRoot.Position - playerPos).Magnitude
            if dist <= getgenv().DirectTPConfig.ScanRadius then
                
                local targetCFrame
                if mode == "Void" then
                    -- Teleport straight down into the kill zone below current X/Z position
                    targetCFrame = CFrame.new(mobRoot.Position.X, getgenv().DirectTPConfig.VoidYLevel, mobRoot.Position.Z)
                elseif mode == "Bring" then
                    -- Teleport right in front of the player
                    targetCFrame = playerRoot.CFrame * CFrame.new(0, 0, -getgenv().DirectTPConfig.BringOffset)
                end

                if targetCFrame then
                    if mobModel.PrimaryPart then
                        mobModel:PivotTo(targetCFrame)
                    else
                        mobRoot.CFrame = targetCFrame
                    end

                    -- Zero out velocity to prevent momentum rubberbanding
                    mobRoot.AssemblyLinearVelocity = Vector3.zero
                    mobRoot.AssemblyAngularVelocity = Vector3.zero
                end
            end
        end)
    end

    for _, obj in ipairs(searchContainer:GetChildren()) do
        local valid, mobRoot = isValidMob(obj)
        if valid then
            executeTP(obj, mobRoot)
        elseif obj:IsA("Folder") then
            for _, nestedObj in ipairs(obj:GetChildren()) do
                local nestedValid, nestedRoot = isValidMob(nestedObj)
                if nestedValid then
                    executeTP(nestedObj, nestedRoot)
                end
            end
        end
    end
end

-- State Connection Handler
local function updateLoopState()
    if TPLoopConnection then
        TPLoopConnection:Disconnect()
        TPLoopConnection = nil
    end

    if getgenv().DirectTPConfig.Mode ~= "None" then
        TPLoopConnection = Services.RunService.Heartbeat:Connect(processTeleports)
    end
end

-- ---------------------------------------------------------------------
-- Rayfield UI Setup
-- ---------------------------------------------------------------------
local Window = Rayfield:CreateWindow({
   Name = "Direct Mob Teleport Engine",
   LoadingTitle = "Loading Teleport Engine...",
   LoadingSubtitle = "by Keith",
   ConfigurationSaving = { Enabled = false },
   Discord = { Enabled = false },
   KeySystem = false
})

local MainTab = Window:CreateTab("Teleport Modes", 4483362458)

MainTab:CreateSection("Mode Selection")

MainTab:CreateDropdown({
   Name = "Active Teleport Mode",
   Options = {"None", "Teleport to Void", "Bring to Player"},
   CurrentOption = {"None"},
   MultipleOptions = false,
   Flag = "ModeDropdown",
   Callback = function(Option)
      local selected = Option[1] or Option
      if selected == "Teleport to Void" then
         getgenv().DirectTPConfig.Mode = "Void"
      elseif selected == "Bring to Player" then
         getgenv().DirectTPConfig.Mode = "Bring"
      else
         getgenv().DirectTPConfig.Mode = "None"
      end
      updateLoopState()
   end,
})

MainTab:CreateSection("Void Mode Settings")

MainTab:CreateSlider({
   Name = "Void Y-Height Level",
   Range = {-1000, -50},
   Increment = 25,
   Suffix = "Y",
   CurrentValue = -300,
   Flag = "VoidYSlider",
   Callback = function(Value)
      getgenv().DirectTPConfig.VoidYLevel = Value
   end,
})

MainTab:CreateSection("Bring Mode Settings")

MainTab:CreateSlider({
   Name = "Bring Distance (In Front of You)",
   Range = {2, 15},
   Increment = 1,
   Suffix = "Studs",
   CurrentValue = 4,
   Flag = "BringOffsetSlider",
   Callback = function(Value)
      getgenv().DirectTPConfig.BringOffset = Value
   end,
})

MainTab:CreateSection("General Settings")

MainTab:CreateSlider({
   Name = "Scan Radius",
   Range = {50, 1000},
   Increment = 25,
   Suffix = "Studs",
   CurrentValue = 350,
   Flag = "RadiusSlider",
   Callback = function(Value)
      getgenv().DirectTPConfig.ScanRadius = Value
   end,
})

MainTab:CreateInput({
   Name = "Custom Workspace Folder",
   PlaceholderText = "e.g., Mobs, Enemies (Leave empty for Workspace)",
   RemoveTextOnFocusLost = false,
   Callback = function(Text)
      getgenv().DirectTPConfig.CustomFolderName = string.gsub(Text, "%s+", "")
   end,
})

MainTab:CreateSection("Script Controls")

MainTab:CreateButton({
   Name = "Unload / Destroy Script",
   Callback = function()
      getgenv().DirectTPConfig.Mode = "None"
      updateLoopState()
      Rayfield:Notify({
         Title = "Script Unloaded",
         Content = "Disabled loops & destroyed UI.",
         Duration = 3,
      })
      task.wait(0.3)
      Rayfield:Destroy()
   end,
})

Rayfield:Notify({
   Title = "Teleport Engine Loaded",
   Content = "Select 'Teleport to Void' or 'Bring to Player' from the dropdown!",
   Duration = 4,
})
