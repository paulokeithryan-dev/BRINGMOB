   Callback = function(Value)
      getgenv().BringMobsConfig.DisableCollision = Value
   end,
})

CombatTab:CreateToggle({
   Name = "Freeze Mob Movement",
   CurrentValue = false,
   Flag = "FreezeMobsToggle",
   Callback = function(Value)
      getgenv().BringMobsConfig.FreezeHumanoids = Value
   end,
})

CombatTab:CreateSection("Filters & Target Folders")

CombatTab:CreateInput({
   Name = "Custom Folder Name (Optional)",
   PlaceholderText = "e.g., Mobs, Enemies (Leave empty for Workspace)",
   RemoveTextOnFocusLost = false,
   Callback = function(Text)
      getgenv().BringMobsConfig.CustomFolderName = string.gsub(Text, "%s+", "")
   end,
})

CombatTab:CreateInput({
   Name = "Mob Whitelist (Comma Separated)",
   PlaceholderText = "e.g., Goblin, Bandit, Zombie",
   RemoveTextOnFocusLost = false,
   Callback = function(Text)
      local list = {}
      for entry in string.gmatch(Text, "[^,]+") do
          local trimmed = string.match(entry, "^%s*(.-)%s*$")
          if trimmed ~= "" then table.insert(list, trimmed) end
      end
      getgenv().BringMobsConfig.Whitelist = list
   end,
})

CombatTab:CreateInput({
   Name = "Mob Blacklist (Comma Separated)",
   PlaceholderText = "e.g., Boss, NPC",
   RemoveTextOnFocusLost = false,
   Callback = function(Text)
      local list = {}
      for entry in string.gmatch(Text, "[^,]+") do
          local trimmed = string.match(entry, "^%s*(.-)%s*$")
          if trimmed ~= "" then table.insert(list, trimmed) end
      end
      getgenv().BringMobsConfig.Blacklist = list
   end,
})

