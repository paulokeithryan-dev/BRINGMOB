-- =====================================================================
-- PURE MOB NOCLIP ENGINE (LURE & DROP EDITION)
-- Disables collisions on mobs every Stepped frame so they fall off edges
-- =====================================================================

local Services = {
    Players = game:GetService("Players"),
    RunService = game:GetService("RunService"),
    Workspace = game:GetService("Workspace")
}

local LocalPlayer = Services.Players.LocalPlayer

-- Configuration Matrix
getgenv().MobNoclipConfig = getgenv().MobNoclipConfig or {
    Enabled = false,                 -- Toggle state
    Distance = 300,                  -- Distance radius around player
    IgnorePlayers = true,            -- Ignore player characters
    CustomFolderName = ""            -- Custom Workspace folder if mobs are stored separately
}

local NoclipConnection = nil

-- Multi-Mirror Safe Rayfield Loader
local Rayfield = nil
local rayfieldURLs = {
    "https://raw.githubusercontent.com/shlexware/Rayfield/main/source",
    "https://sirius.menu/rayfield",
    "https://raw.githubusercontent.com/SiriusSoftwareLTD/Rayfield/main/source"
}

for _, url in ipairs(rayfieldURLs) do
    local success, result = pcall(function()
        return loadstring(game:HttpGet(url))()
    end)
    if success and result then
        Rayfield = result
        break
    end
end

if not Rayfield then return end

-- Validate NPC / Mob
local function isValidMob(model)
    if not model or not model:IsA("Model") then return false end

    -- Do not target real players
    if getgenv().MobNoclipConfig.IgnorePlayers and Services.Players:GetPlayerFromCharacter(model) then
        return false
    end

    local humanoid = model:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then
        return false
    end

    local rootPart = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso")
    if not rootPart then
        return false
    end

    return true, rootPart
end

-- Continuous NoClip Core Engine
local function processMobNoclip()
    if not getgenv().MobNoclipConfig.Enabled then return end

    local character = LocalPlayer.Character
    local playerRoot = character and character:FindFirstChild("HumanoidRootPart")
    if not playerRoot then return end

    local playerPos = playerRoot.Position
    local searchContainer = Services.Workspace

    if getgenv().MobNoclipConfig.CustomFolderName ~= "" then
        local folder = Services.Workspace:FindFirstChild(getgenv().MobNoclipConfig.CustomFolderName)
        if folder then searchContainer = folder end
    end

    local function applyNoclipToModel(mobModel, mobRoot)
        pcall(function()
            local dist = (mobRoot.Position - playerPos).Magnitude
            if dist <= getgenv().MobNoclipConfig.Distance then
                -- Disable collisions on ALL descendant parts of the mob
                for _, part in ipairs(mobModel:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
    end

    -- Process workspace objects
    for _, obj in ipairs(searchContainer:GetChildren()) do
        local valid, mobRoot = isValidMob(obj)
        if valid then
            applyNoclipToModel(obj, mobRoot)
        elseif obj:IsA("Folder") then
            for _, nestedObj in ipairs(obj:GetChildren()) do
                local nestedValid, nestedRoot = isValidMob(nestedObj)
                if nestedValid then
                    applyNoclipToModel(nestedObj, nestedRoot)
                end
            end
        end
    end
end

-- Enable / Disable Connection Handler
local function setNoclipState(state)
    getgenv().MobNoclipConfig.Enabled = state

    if NoclipConnection then
        NoclipConnection:Disconnect()
        NoclipConnection = nil
    end

    if state then
        -- RunService.Stepped runs right BEFORE physics calculation every frame
        NoclipConnection = Services.RunService.Stepped:Connect(processMobNoclip)
    end
end

-- ---------------------------------------------------------------------
-- Rayfield UI Setup
-- ---------------------------------------------------------------------
local Window = Rayfield:CreateWindow({
   Name = "Mob NoClip Engine",
   LoadingTitle = "Loading Engine...",
   LoadingSubtitle = "by Keith",
   ConfigurationSaving = { Enabled = false },
   Discord = { Enabled = false },
   KeySystem = false
})

local MainTab = Window:CreateTab("Lure & Drop", 4483362458)

MainTab:CreateSection("Main Controls")

MainTab:CreateToggle({
   Name = "Enable Mob NoClip",
   CurrentValue = false,
   Flag = "MobNoclipToggle",
   Callback = function(Value)
      setNoclipState(Value)
   end,
})

MainTab:CreateSlider({
   Name = "NoClip Range (Studs)",
   Range = {50, 1000},
   Increment = 25,
   Suffix = "Studs",
   CurrentValue = 300,
   Flag = "DistanceSlider",
   Callback = function(Value)
      getgenv().MobNoclipConfig.Distance = Value
   end,
})

MainTab:CreateSection("Target Settings")

MainTab:CreateInput({
   Name = "Custom Folder Name",
   PlaceholderText = "e.g., Mobs, Enemies (Leave empty for Workspace)",
   RemoveTextOnFocusLost = false,
   Callback = function(Text)
      getgenv().MobNoclipConfig.CustomFolderName = string.gsub(Text, "%s+", "")
   end,
})

MainTab:CreateSection("Script Controls")

MainTab:CreateButton({
   Name = "Unload / Destroy Script",
   Callback = function()
      setNoclipState(false)
      Rayfield:Notify({
         Title = "Script Unloaded",
         Content = "Disabled NoClip connection & destroyed UI.",
         Duration = 3,
      })
      task.wait(0.3)
      Rayfield:Destroy()
   end,
})

Rayfield:Notify({
   Title = "Mob NoClip Ready",
   Content = "Turn ON 'Enable Mob NoClip' and lead mobs over the edge!",
   Duration = 4,
})
