-- ULTIMATE VOID DROP & WALL BYPASS ENGINE
-- Combines HipHeight Sink, Outward Nudge, Waypoint Override & Spin Slip
-- =====================================================================

local Services = {
    Players = game:GetService("Players"),
    RunService = game:GetService("RunService"),
    Workspace = game:GetService("Workspace")
}

local LocalPlayer = Services.Players.LocalPlayer

-- Configuration
getgenv().VoidDropConfig = getgenv().VoidDropConfig or {
    Enabled = false,                 -- Master Toggle
    PushForce = 2.5,                 -- Studs shifted per frame
    SinkDepth = -5,                  -- HipHeight offset to sink under wall bounds
    DropRange = 350,                 -- Scan radius in studs
    ApplySpinFling = true,           -- Rotational spin to slip along corners
    IgnorePlayers = true,            -- Ignore real player models
    CustomFolderName = ""            -- Workspace folder override
}

local HeartbeatConnection = nil

-- Multi-Mirror Safe Rayfield Loader
local Rayfield = nil
local rayfieldURLs = {
    "https://raw.githubusercontent.com/shlexware/Rayfield/main/source",
    "https://sirius.menu/rayfield",
    "https://raw.githubusercontent.com/SiriusSoftwareLTD/Rayfield/main/source"
}

for _, url in ipairs(rayfieldURLs) do
    local success, result = pcall(function()
        return loadstring(game:HttpGet(url))()
    end)
    if success and result then
        Rayfield = result
        break
    end
end

if not Rayfield then return end

-- Validate NPC / Mob
local function isValidMob(model)
    if not model or not model:IsA("Model") then return false end

    if getgenv().VoidDropConfig.IgnorePlayers and Services.Players:GetPlayerFromCharacter(model) then
        return false
    end

    local humanoid = model:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return false end

    local rootPart = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso")
    if not rootPart then return false end

    return true, rootPart, humanoid
end

-- Multi-Bypass Frame Processor
local function processVoidDrop()
    if not getgenv().VoidDropConfig.Enabled then return end

    local character = LocalPlayer.Character
    local playerRoot = character and character:FindFirstChild("HumanoidRootPart")
    if not playerRoot then return end

    local playerPos = playerRoot.Position
    local searchContainer = Services.Workspace

    if getgenv().VoidDropConfig.CustomFolderName ~= "" then
        local folder = Services.Workspace:FindFirstChild(getgenv().VoidDropConfig.CustomFolderName)
        if folder then searchContainer = folder end
    end

    local function applyBypassAndPush(mobModel, mobRoot, humanoid)
        pcall(function()
            local dist = (mobRoot.Position - playerPos).Magnitude
            if dist <= getgenv().VoidDropConfig.DropRange then
                
                -- 1. Sink HipHeight below floor/wall colliders
                humanoid.HipHeight = getgenv().VoidDropConfig.SinkDepth

                -- 2. Calculate outward vector pointing away from player
                local pushDir = (mobRoot.Position - playerPos).Unit
                if pushDir.Magnitude == 0 or pushDir ~= pushDir then
                    pushDir = playerRoot.CFrame.LookVector
                end

                -- 3. Step CFrame past wall bounds incrementally
                local targetPos = mobRoot.Position + (pushDir * getgenv().VoidDropConfig.PushForce)
                mobRoot.CFrame = CFrame.new(targetPos, targetPos + pushDir)

                -- 4. Spoof Humanoid pathfinding target out into the void
                humanoid:MoveTo(mobRoot.Position + (pushDir * 100))

                -- 5. Strip local part collision
                for _, part in ipairs(mobModel:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                        part.CanTouch = false
                    end
                end

                -- 6. Unlock physics states and apply downward + outward velocity
                humanoid.PlatformStand = true
                humanoid:ChangeState(Enum.HumanoidStateType.Physics)

                if getgenv().VoidDropConfig.ApplySpinFling then
                    mobRoot.AssemblyAngularVelocity = Vector3.new(0, 500, 0)
                end
                mobRoot.AssemblyLinearVelocity = (pushDir * 40) + Vector3.new(0, -60, 0)
            end
        end)
    end

    for _, obj in ipairs(searchContainer:GetChildren()) do
        local valid, mobRoot, humanoid = isValidMob(obj)
        if valid then
            applyBypassAndPush(obj, mobRoot, humanoid)
        elseif obj:IsA("Folder") then
            for _, nestedObj in ipairs(obj:GetChildren()) do
                local nestedValid, nestedRoot, nestedHumanoid = isValidMob(nestedObj)
                if nestedValid then
                    applyBypassAndPush(nestedObj, nestedRoot, nestedHumanoid)
                end
            end
        end
    end
end

-- Engine State Manager
local function setEngineState(state)
    getgenv().VoidDropConfig.Enabled = state

    if HeartbeatConnection then
        HeartbeatConnection:Disconnect()
        HeartbeatConnection = nil
    end

    if state then
        HeartbeatConnection = Services.RunService.Heartbeat:Connect(processVoidDrop)
    else
        -- Restore mob states on disable
        pcall(function()
            local searchContainer = Services.Workspace
            if getgenv().VoidDropConfig.CustomFolderName ~= "" then
                local folder = Services.Workspace:FindFirstChild(getgenv().VoidDropConfig.CustomFolderName)
                if folder then searchContainer = folder end
            end

            for _, obj in ipairs(searchContainer:GetChildren()) do
                local valid, _, humanoid = isValidMob(obj)
                if valid and humanoid then
                    humanoid.HipHeight = 2
                    humanoid.PlatformStand = false
                    humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
                end
            end
        end)
    end
end

