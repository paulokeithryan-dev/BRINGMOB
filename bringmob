-- =====================================================================
-- MOB NOCLIP & GROUND-UNLOCK ENGINE (LURE & FALL)
-- Disables Humanoid Ground-Snapping + Collision to force void falls
-- =====================================================================

local Services = {
    Players = game:GetService("Players"),
    RunService = game:GetService("RunService"),
    Workspace = game:GetService("Workspace")
}

local LocalPlayer = Services.Players.LocalPlayer

-- Config Matrix
getgenv().MobNoclipConfig = getgenv().MobNoclipConfig or {
    Enabled = false,                 -- Master Toggle
    Distance = 300,                  -- Scan Radius
    ForcePlatformStand = true,       -- Disables humanoid ground-snapping
    ApplyVoidPush = true,            -- Subtle downward/outward push when lured
    IgnorePlayers = true,            -- Ignore player characters
    CustomFolderName = ""            -- Workspace folder override
}

local NoclipConnection = nil

-- Multi-Mirror Safe Rayfield Loader
local Rayfield = nil
local rayfieldURLs = {
    "https://raw.githubusercontent.com/shlexware/Rayfield/main/source",
    "https://sirius.menu/rayfield",
    "https://raw.githubusercontent.com/SiriusSoftwareLTD/Rayfield/main/source"
}

for _, url in ipairs(rayfieldURLs) do
    local success, result = pcall(function()
        return loadstring(game:HttpGet(url))()
    end)
    if success and result then
        Rayfield = result
        break
    end
end

if not Rayfield then return end

-- Validate NPC / Mob
local function isValidMob(model)
    if not model or not model:IsA("Model") then return false end

    if getgenv().MobNoclipConfig.IgnorePlayers and Services.Players:GetPlayerFromCharacter(model) then
        return false
    end

    local humanoid = model:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then
        return false
    end

    local rootPart = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso")
    if not rootPart then
        return false
    end

    return true, rootPart, humanoid
end

-- Core Engine Phase Loop
local function processMobNoclip()
    if not getgenv().MobNoclipConfig.Enabled then return end

    local character = LocalPlayer.Character
    local playerRoot = character and character:FindFirstChild("HumanoidRootPart")
    if not playerRoot then return end

    local playerPos = playerRoot.Position
    local searchContainer = Services.Workspace

    if getgenv().MobNoclipConfig.CustomFolderName ~= "" then
        local folder = Services.Workspace:FindFirstChild(getgenv().MobNoclipConfig.CustomFolderName)
        if folder then searchContainer = folder end
    end

    local function applyNoclipToModel(mobModel, mobRoot, humanoid)
        pcall(function()
            local dist = (mobRoot.Position - playerPos).Magnitude
            if dist <= getgenv().MobNoclipConfig.Distance then
                
                -- 1. Strip all part collisions and query physics
                for _, part in ipairs(mobModel:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                        part.CanTouch = false
                    end
                end

                -- 2. Break Humanoid Ground-Raycast Snapping
                if getgenv().MobNoclipConfig.ForcePlatformStand then
                    humanoid.PlatformStand = true
                    humanoid:ChangeState(Enum.HumanoidStateType.Physics)
                end

                -- 3. Apply downward force so gravity takes over instantly
                if getgenv().MobNoclipConfig.ApplyVoidPush then
                    mobRoot.AssemblyLinearVelocity = Vector3.new(
                        mobRoot.AssemblyLinearVelocity.X,
                        -30,
                        mobRoot.AssemblyLinearVelocity.Z
                    )
                end
            end
        end)
    end

    -- Scan workspace
    for _, obj in ipairs(searchContainer:GetChildren()) do
        local valid, mobRoot, humanoid = isValidMob(obj)
        if valid then
            applyNoclipToModel(obj, mobRoot, humanoid)
        elseif obj:IsA("Folder") then
            for _, nestedObj in ipairs(obj:GetChildren()) do
                local nestedValid, nestedRoot, nestedHumanoid = isValidMob(nestedObj)
                if nestedValid then
                    applyNoclipToModel(nestedObj, nestedRoot, nestedHumanoid)
                end
            end
        end
    end
end

-- Enable/Disable State Handler
local function setNoclipState(state)
    getgenv().MobNoclipConfig.Enabled = state

    if NoclipConnection then
        NoclipConnection:Disconnect()
        NoclipConnection = nil
    end

    if state then
        -- Runs every frame prior to physics step
        NoclipConnection = Services.RunService.Stepped:Connect(processMobNoclip)
    else
        -- Restore PlatformStand on disable so mobs can walk again if needed
        pcall(function()
            for _, obj in ipairs(Services.Workspace:GetChildren()) do
                local valid, _, humanoid = isValidMob(obj)
                if valid and humanoid then
                    humanoid.PlatformStand = false
                    humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
                end
            end
        end)
    end
end

