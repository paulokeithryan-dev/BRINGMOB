-- =====================================================================
-- MOB NOCLIP & VOID DROP ENGINE + RAYFIELD UI (WITH UNLOAD FEATURE)
-- Applies continuous NoClip (Stepped loop) to force mobs through floor
-- =====================================================================

local Services = {
    Players = game:GetService("Players"),
    RunService = game:GetService("RunService"),
    Workspace = game:GetService("Workspace")
}

local LocalPlayer = Services.Players.LocalPlayer

-- Configuration
getgenv().BringMobsConfig = getgenv().BringMobsConfig or {
    NoclipEnabled = false,           -- Master NoClip Toggle
    PushDownward = true,             -- Applies downward physics force
    BringDistance = 300,             -- Radius in studs
    IgnorePlayers = true,            -- Ignore player characters
    CustomFolderName = "",           -- Target folder in Workspace
    Whitelist = {},                  -- Name whitelist
    Blacklist = {}                   -- Name blacklist
}

local NoclipLoopConnection = nil

-- Multi-Mirror Rayfield Loader
local Rayfield = nil
local rayfieldURLs = {
    "https://raw.githubusercontent.com/shlexware/Rayfield/main/source",
    "https://sirius.menu/rayfield",
    "https://raw.githubusercontent.com/SiriusSoftwareLTD/Rayfield/main/source"
}

for _, url in ipairs(rayfieldURLs) do
    local success, result = pcall(function()
        return loadstring(game:HttpGet(url))()
    end)
    if success and result then
        Rayfield = result
        break
    end
end

if not Rayfield then return end

-- Validate Mob Function
local function isValidMob(model)
    if not model or not model:IsA("Model") then return false end

    if getgenv().BringMobsConfig.IgnorePlayers and Services.Players:GetPlayerFromCharacter(model) then
        return false
    end

    local humanoid = model:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then
        return false
    end

    local rootPart = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso")
    if not rootPart then
        return false
    end

    local modelName = string.lower(model.Name)

    -- Whitelist Check
    local whitelist = getgenv().BringMobsConfig.Whitelist
    if #whitelist > 0 then
        local matched = false
        for _, name in ipairs(whitelist) do
            if string.find(modelName, string.lower(name)) then
                matched = true
                break
            end
        end
        if not matched then return false end
    end

    -- Blacklist Check
    local blacklist = getgenv().BringMobsConfig.Blacklist
    if #blacklist > 0 then
        for _, name in ipairs(blacklist) do
            if string.find(modelName, string.lower(name)) then
                return false
            end
        end
    end

    return true, rootPart, humanoid
end

-- Process NoClip on Stepped (Executes BEFORE physics step)
local function processMobNoclip()
    if not getgenv().BringMobsConfig.NoclipEnabled then return end

    local character = LocalPlayer.Character
    local playerRoot = character and character:FindFirstChild("HumanoidRootPart")
    if not playerRoot then return end

    local searchContainer = Services.Workspace
    if getgenv().BringMobsConfig.CustomFolderName ~= "" then
        local foundFolder = Services.Workspace:FindFirstChild(getgenv().BringMobsConfig.CustomFolderName)
        if foundFolder then searchContainer = foundFolder end
    end

    local function applyNoclipToMob(mobModel, mobRoot)
        pcall(function()
            local dist = (mobRoot.Position - playerRoot.Position).Magnitude
            if dist <= getgenv().BringMobsConfig.BringDistance then
                
                -- Force CanCollide = false on ALL parts of the mob model
                for _, part in ipairs(mobModel:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end

                -- Optional downward force to accelerate falling through floor
                if getgenv().BringMobsConfig.PushDownward then
                    mobRoot.AssemblyLinearVelocity = Vector3.new(0, -50, 0)
                end
            end
        end)
    end

    for _, obj in ipairs(searchContainer:GetChildren()) do
        local valid, mobRoot = isValidMob(obj)
        if valid then
            applyNoclipToMob(obj, mobRoot)
        elseif obj:IsA("Folder") then
            for _, nestedObj in ipairs(obj:GetChildren()) do
                local nestedValid, nestedRoot = isValidMob(nestedObj)
                if nestedValid then
                    applyNoclipToMob(nestedObj, nestedRoot)
                end
            end
        end
    end
end

-- Toggle Connection Engine
local function setNoclipState(state)
    getgenv().BringMobsConfig.NoclipEnabled = state

    if NoclipLoopConnection then
        NoclipLoopConnection:Disconnect()
        NoclipLoopConnection = nil
    end

    if state then
        -- MUST use Stepped so collision state is overridden right before physics step
        NoclipLoopConnection = Services.RunService.Stepped:Connect(processMobNoclip)
    end
end

