-- =====================================================================
-- INSTANT GROUND DROP & TP MOBS ENGINE
-- Raycasts ground level beneath player and teleports mobs onto floor
-- =====================================================================

local Services = {
    Players = game:GetService("Players"),
    RunService = game:GetService("RunService"),
    Workspace = game:GetService("Workspace")
}

local LocalPlayer = Services.Players.LocalPlayer

-- Config Matrix
getgenv().BringMobsConfig = getgenv().BringMobsConfig or {
    Enabled = false,                 -- Toggle state
    BringDistance = 300,             -- Radius in studs
    UnderOffset = 3,                 -- Height above ground to drop them from
    TeleportInterval = 0.3,          -- TP pulse frequency (seconds) to allow physics simulation
    IgnorePlayers = true,            -- Ignore player characters
    CustomFolderName = "",           -- Target folder in Workspace
    Whitelist = {},                  -- Name whitelist
    Blacklist = {}                   -- Name blacklist
}

local BringLoopConnection = nil
local lastTPTime = 0

-- Multi-Mirror Rayfield Loader
local Rayfield = nil
local rayfieldURLs = {
    "https://raw.githubusercontent.com/shlexware/Rayfield/main/source",
    "https://sirius.menu/rayfield",
    "https://raw.githubusercontent.com/SiriusSoftwareLTD/Rayfield/main/source"
}

for _, url in ipairs(rayfieldURLs) do
    local success, result = pcall(function()
        return loadstring(game:HttpGet(url))()
    end)
    if success and result then
        Rayfield = result
        break
    end
end

if not Rayfield then return end

-- Validate Mob
local function isValidMob(model)
    if not model or not model:IsA("Model") then return false end

    if getgenv().BringMobsConfig.IgnorePlayers and Services.Players:GetPlayerFromCharacter(model) then
        return false
    end

    local humanoid = model:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then
        return false
    end

    local rootPart = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso")
    if not rootPart then
        return false
    end

    local modelName = string.lower(model.Name)

    -- Whitelist
    local whitelist = getgenv().BringMobsConfig.Whitelist
    if #whitelist > 0 then
        local matched = false
        for _, name in ipairs(whitelist) do
            if string.find(modelName, string.lower(name)) then
                matched = true
                break
            end
        end
        if not matched then return false end
    end

    -- Blacklist
    local blacklist = getgenv().BringMobsConfig.Blacklist
    if #blacklist > 0 then
        for _, name in ipairs(blacklist) do
            if string.find(modelName, string.lower(name)) then
                return false
            end
        end
    end

    return true, rootPart, humanoid
end

-- Raycast ground height directly below player
local function getGroundTargetCFrame(playerRoot)
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = {LocalPlayer.Character}

    -- Cast ray 100 studs down from player
    local rayResult = Services.Workspace:Raycast(playerRoot.Position, Vector3.new(0, -100, 0), rayParams)
    
    if rayResult then
        -- Position slightly above detected floor
        return CFrame.new(rayResult.Position + Vector3.new(0, getgenv().BringMobsConfig.UnderOffset, 0))
    else
        -- Fallback: 5 studs below player root
        return CFrame.new(playerRoot.Position - Vector3.new(0, 5, 0))
    end
end

-- Teleport and drop logic
local function processBringAndDrop()
    if not getgenv().BringMobsConfig.Enabled then return end

    -- Pulse timer: allows physics and gravity to take effect between TPs
    if tick() - lastTPTime < getgenv().BringMobsConfig.TeleportInterval then return end
    lastTPTime = tick()

    local character = LocalPlayer.Character
    local playerRoot = character and character:FindFirstChild("HumanoidRootPart")
    if not playerRoot then return end

    local targetDropCFrame = getGroundTargetCFrame(playerRoot)

    local searchContainer = Services.Workspace
    if getgenv().BringMobsConfig.CustomFolderName ~= "" then
        local foundFolder = Services.Workspace:FindFirstChild(getgenv().BringMobsConfig.CustomFolderName)
        if foundFolder then searchContainer = foundFolder end
    end

    local function bringMob(mobModel, mobRoot)
        pcall(function()
            local dist = (mobRoot.Position - playerRoot.Position).Magnitude
            if dist <= getgenv().BringMobsConfig.BringDistance then
                
                -- Ensure root part has collision for floor interaction
                mobRoot.CanCollide = true

                -- Apply downward velocity so gravity drops them immediately
                mobRoot.AssemblyLinearVelocity = Vector3.new(0, -20, 0)

                -- Teleport to ground target position
                if mobModel.PrimaryPart then
                    mobModel:PivotTo(targetDropCFrame)
                else
                    mobRoot.CFrame = targetDropCFrame
                end
            end
        end)
    end

    for _, obj in ipairs(searchContainer:GetChildren()) do
        local valid, mobRoot = isValidMob(obj)
        if valid then
            bringMob(obj, mobRoot)
        elseif obj:IsA("Folder") then
            for _, nestedObj in ipairs(obj:GetChildren()) do
                local nestedValid, nestedRoot = isValidMob(nestedObj)
                if nestedValid then
                    bringMob(nestedObj, nestedRoot)
                end
            end
        end
    end
end

local function setEngineState(state)
    getgenv().BringMobsConfig.Enabled = state

    if BringLoopConnection then
        BringLoopConnection:Disconnect()
        BringLoopConnection = nil
    end

    if state then
        BringLoopConnection = Services.RunService.Heartbeat:Connect(processBringAndDrop)
    end
end

